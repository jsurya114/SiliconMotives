# ── Site ──────────────────────────────────────────────
# Canonical origin of the live site (required for search indexing)
SITE_URL=https://www.your-siliconmotives-domain.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Supabase (Project Settings → API) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never expose. Used by /api/contact and /api/testimonials.
SUPABASE_SERVICE_ROLE_KEY=

# Secret random string (e.g. `openssl rand -hex 32`) used to hash visitor IPs.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset; keep it secret.
IP_HASH_SALT=

# ── Notifications (optional) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_ADMIN_NUMBER=
